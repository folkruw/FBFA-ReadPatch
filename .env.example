# Token du bot (portail développeur Discord → Bot → Reset Token)
DISCORD_TOKEN=


# Fuseau horaire pour interpréter les dates saisies (« 01/11/2026 18:30 »)
TZ=Europe/Paris

# Emplacement de la base SQLite
DB_PATH=data/bot.db

# Au démarrage, le bot relit l'historique pour rattraper les réactions ajoutées
# pendant qu'il était éteint. 0 = tout l'historique déjà lu, sinon nombre de jours.
STARTUP_RESCAN_DAYS=0

# ── API locale pour Flash (page « Patch notes ») ──
# Laisser API_PORT vide = API désactivée. Elle n'écoute que sur 127.0.0.1.
API_PORT=
# Clé secrète (16 caractères minimum) : la même valeur va dans le .env de Flash.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_CLE=
# Optionnel : serveur Discord utilisé par l'API si le bot est sur plusieurs serveurs.
API_GUILD_ID=
